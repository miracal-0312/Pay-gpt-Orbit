# Pay-gpt-Orbit 环境模板
# 复制为 .env 后填写；已有 .env 请合并新增配置，勿覆盖已有值。
# npm start / node server.js 自动读取项目根目录 .env，已有进程环境变量优先。
# Docker Compose 读取 .env 并注入列出的变量；修改后需重建 app 容器。
# 含 #、$ 或空格的值用单引号包裹，例如 DB_PASSWORD='replace#this$value'。

# ===== Web 服务与管理员（先填写）=====
PORT=3000
JSON_BODY_LIMIT=15mb
# 生产部署设置随机值，可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 生成
ADMIN_TOKEN_SECRET=
# 以下管理员信息仅初始化新数据库；已有账号和路径在后台修改。
ADMIN_EMAIL=admin@vru.cc
ADMIN_PASSWORD=
ADMIN_SECONDARY_PASSWORD=
ADMIN_LOGIN_PATH=admin-login
ADMIN_PANEL_PATH=admin

# ===== MySQL（先填写）=====
# 裸机使用以下连接信息；Compose 内部固定使用 mysql:3306 / root。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plus_papay
DB_POOL_LIMIT=60

# ===== Orbitcard 代充（启用第三方代充时必填）=====
# 仅服务端保存 HMAC Secret；此值必须与后台填写的 API Key 配对。
ORBITCARD_API_SECRET=
# 在管理后台「系统配置 → 第三方代充 API」配置：
# HTTPS 根域名（默认 https://orbitcard.cc）、API Key、平台卡 ID。
# 可选支付地区、最高 USDT 服务费；Key / 卡 ID / 开关不从 .env 导入。
# 不再使用旧 Bearer 代充协议或旧套餐 key / country / currency 配置。

# ===== 本地浏览器自动化（仅 Orbitcard 代充时保持关闭）=====
# 数据库中已保存的浏览器池开关优先，已有部署也请在后台关闭。
BROWSER_POOL=0
BROWSER_POOL_SIZE=2
BROWSER_POOL_MAX_SIZE=24
BROWSER_POOL_BASE_PORT=19222
HEADFUL=0
# 以下仅用于 Docker 有头调试；HEADFUL=1 时必须填写密码。
VNC_PASSWORD=
NOVNC_PORT=6080
# 以下仅裸机使用；Docker 使用镜像内置 Chromium / Python。
CHROMIUM_CHANNEL=
HCAPTCHA_SOLVER_PYTHON=

# ===== 本地 Stripe / 浏览器流程的可选配置 =====
# Orbitcard 通过上游验证链接完成人机验证，无需本地验证码服务。
# HCAPTCHA_VLM_API_KEY=
# HCAPTCHA_VLM_BASE_URL=https://api.openai.com/v1
# HCAPTCHA_VLM_MODEL=gpt-5.5
# HCAPTCHA_CAPTCHA_PLATFORM_API_KEY=
# HCAPTCHA_CAPTCHA_PLATFORM_API_URL=https://api.capsolver.com
# HCAPTCHA_CAPTCHA_PLATFORM_TIMEOUT=180
# CHATGPT_SESSION_COOKIE=
# 本地代理支持 {session} 占位符；Orbitcard 订单不使用此项。
PROXY=
# 以下裸机本地流程参数，Docker 请在后台资产池中管理卡片与账单地址。
CHATGPT_TOKEN=
STRIPE_KEY=
BILLING_COUNTRY=US
BILLING_ADDRESS=
BILLING_CITY=
BILLING_STATE=
BILLING_ZIP=
BILLING_NAME=
BILLING_PHONE=
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=

# ===== 卡片供应商 Webhook（可选，与 Orbitcard HMAC Secret 不同）=====
# 仅用于本地卡池 CARD_ISSUE 事件验签/解密；首次迁入 MySQL 后在后台管理。
CARD_SUPPLIER_WEBHOOK_SECRET=

# ===== 邮箱通道（可选）=====
INBOX_API_BASE=
INBOX_EMAIL_DOMAINS=
RANDOM_EMAIL_DOMAIN=
# 任务审计日志目录；留空时使用项目 data/logs。Docker 固定写入 /app/data/logs。
# 请备份该目录并监控磁盘空间；完整 JSONL 历史不随后台清空缓存而删除。
TASK_LOG_DIR=
