# Node.js 24+ / MySQL 8. The project .env loads before imports; process variables take precedence.
# Quote passwords containing #, $ or spaces with single quotes. Never commit .env.
PORT=3000
# Optional bind address. Set 127.0.0.1 for local-only access; leave empty in containers.
HOST=
JSON_BODY_LIMIT=256kb
# Leave empty for direct access. Behind a proxy, list only its IP/CIDR (e.g. loopback).
# Never trust arbitrary X-Forwarded-For headers from public clients.
TRUST_PROXY=
API_REQUESTS_PER_MINUTE=180
API_WRITES_PER_MINUTE=30
API_TOTAL_REQUESTS_PER_MINUTE=1200
API_MAX_CONCURRENT=64
API_MAX_CONCURRENT_PER_IP=12
API_MAX_TRACKED_IPS=10000
HTTP_MAX_CONNECTIONS=500
WS_MAX_CONNECTIONS=200
WS_MAX_CONNECTIONS_PER_IP=5
# Native deployment database. Compose uses mysql:3306 / root internally.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plus_papay
DB_POOL_LIMIT=20
DB_QUEUE_LIMIT=100
DB_LOCK_LIMIT=32
# Idle query connections close after 60 seconds; active payment locks are unaffected.
DB_MAX_IDLE=5
DB_STATEMENT_CACHE_LIMIT=256
MYSQL_PORT=3310
# Required on every startup: a random signing secret of at least 32 bytes.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
# Passwords (8+ characters) are needed only when creating missing administrator accounts.
# Existing credentials and paths are managed in the administrator UI.
ADMIN_EMAIL=admin@vru.cc
ADMIN_PASSWORD=
ADMIN_SECONDARY_PASSWORD=
ADMIN_LOGIN_PATH=admin-login
ADMIN_PANEL_PATH=admin
# Required before enabling Orbitcard. Set the matching pair issued by the platform.
# Credentials are read only from the server environment, never from the administrator UI.
# Scopes: subscriptions:read/create, account:read, cards:read/create/fund/manage, products:read, transactions:read.
ORBITCARD_API_KEY=
ORBITCARD_API_SECRET=
# 各套餐 USD 卡支付金额在后台配置，保存在 orbitcard_plan_prices；留空暂停该套餐代充。
# Optional signed redemption callbacks to dujiao-next; empty URL disables new events and delivery.
# URL: https://your-shop.example/api/v1/card-secrets/redemption-callback
# Source must match the shop configuration; secret must be at least 32 bytes and identical on both sides.
CDK_REDEMPTION_WEBHOOK_URL=
CDK_REDEMPTION_SOURCE=pay-gpt-orbit
CDK_REDEMPTION_WEBHOOK_SECRET=
# Native logs default to /var/log/pay-gpt-orbit on Linux or
# C:/ProgramData/Pay-gpt-Orbit/logs on Windows (using the actual system drive).
# Logs use Beijing calendar days: keep today and the previous 14 days.
# Cleanup catches up once at startup, then deletes expired days at Beijing midnight.
TASK_LOG_DIR=
# Compose host system-disk log directory. For Windows Docker set C:/ProgramData/Pay-gpt-Orbit/logs.
APP_LOG_DIR=/var/log/pay-gpt-orbit
# In-memory previews only. Complete audit records remain in TASK_LOG_DIR.
LOG_CACHE_ENTRIES=2000
LOG_CACHE_BYTES=4194304
# Compose data mount; also change PORT/MYSQL_PORT for an isolated deployment.
APP_DATA_DIR=./data
# Optional isolated deployment names; omit to keep existing container names.
# APP_CONTAINER_NAME=pay-gpt-orbit-isolated-app
# MYSQL_CONTAINER_NAME=pay-gpt-orbit-isolated-mysql
